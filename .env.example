# ── Supabase ─────────────────────────────────────────────────────────
# Public Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — RLS enforces access, safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, bypasses RLS, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string used by the API (service role, RLS
# bypassed intentionally at this layer — the API enforces authorization
# in app code, matching Section 8's route-level role checks)
DATABASE_URL=
# Project JWT secret, used to verify Supabase-issued access tokens
# server-side (HS256). If a project is migrated to Supabase's newer
# asymmetric (RS256/ES256) signing keys, swap security.py's verification
# for JWKS-based verification instead of this shared secret.
SUPABASE_JWT_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────
# Secret key for server-side Stripe API calls
STRIPE_SECRET_KEY=
# Publishable key for client-side Stripe Elements/Checkout
STRIPE_PUBLISHABLE_KEY=
# Signing secret used to verify POST /webhooks/stripe payloads
STRIPE_WEBHOOK_SECRET=
# Platform's cut of campaign budget, 30-40% per Section 4 of the spec
STRIPE_PLATFORM_FEE_PERCENT=35
# Same publishable key value as STRIPE_PUBLISHABLE_KEY above, exposed to
# the Next.js client bundle for the exclusivity purchase Stripe Elements
# form (Build Prompt 8C frontend addition) -- publishable keys are safe
# client-side by design.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Resend ───────────────────────────────────────────────────────────
# API key for sending transactional email
RESEND_API_KEY=
# From-address for outbound email
RESEND_FROM_EMAIL=noreply@teenure.com
# Template ID for the parental-consent email (Section 9 / Prompt 4)
RESEND_PARENT_CONSENT_TEMPLATE_ID=
# Template ID for the parent magic-link login email (Section 9A / Prompt 4A)
RESEND_PARENT_MAGIC_LINK_TEMPLATE_ID=
# Template ID for the parent monthly digest email (Section 9A / Prompt 4A)
RESEND_PARENT_DIGEST_TEMPLATE_ID=

# ── App ──────────────────────────────────────────────────────────────
# Public URL of the Next.js app, used in links sent via email
NEXT_PUBLIC_APP_URL=
# Base URL the frontend calls for the FastAPI backend
API_URL=
# Same value as API_URL, exposed to the browser (Next.js only inlines
# NEXT_PUBLIC_-prefixed vars into client bundles) -- used by
# apps/web/lib/api.ts for client-side fetch calls to apps/api.
NEXT_PUBLIC_API_URL=
# Shared secret gating internal/admin-only operations
ADMIN_SECRET_KEY=
# Comma-separated list of origins allowed to call the API via CORS
# (the web app's own origin(s) only — never "*" in any environment)
ALLOWED_ORIGINS=http://localhost:3100

# ── Scheduled jobs ───────────────────────────────────────────────────
# Shared secret the scheduler (Railway cron) must present to
# POST /internal/jobs/run/:job_name — see app/jobs/runner.py
JOBS_RUNNER_SECRET=

# ── Feature flags ────────────────────────────────────────────────────
# Minimum age allowed to sign up as a rep at all (Section 9 age gate:
# "under 13 blocked entirely" / Section 8: "age < 13 -> 400"). 13, not
# 14 -- corrected from this file's original default, which contradicted
# the literal age-gate text elsewhere in the spec.
MIN_REP_AGE=13
# Below this age, parental consent is required before activation
PARENTAL_CONSENT_REQUIRED_UNDER=16

# ── Parent Portal (Section 9A / Prompt 4A) ─────────────────────────────
# HS256 signing secret for parent session tokens. Distinct from
# SUPABASE_JWT_SECRET -- parents have no auth.users identity and are
# never issued a Supabase-signed JWT.
PARENT_SESSION_SECRET=

# ── Brand Portal (Section 7 / Prompt 8) ─────────────────────────────
# Fernet key encrypting brand_profiles.ein at the application layer
# (Section 7: "ein TEXT, -- stored encrypted in production"). Generate
# with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EIN_ENCRYPTION_KEY=

# ── Analytics (PostHog, Section 6 / Build Prompt 19) ────────────────
# PostHog EU Cloud project key. Client-side only -- see docs/analytics.md
# for the self-hosted-vs-cloud decision. Left blank, analytics is
# inactive everywhere (lib/analytics.ts no-ops) rather than throwing.
NEXT_PUBLIC_POSTHOG_KEY=
# EU Cloud ingestion host, keeps all event data in-region.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Category Exclusivity (Build Prompt 8C) ──────────────────────────
# Admin-set pricing: $/day (in cents) charged for exclusive rights to a
# category within one city (or platform-wide, if city is omitted) for a
# given window. A config value, not a schema value -- change this and
# redeploy, no migration needed.
EXCLUSIVITY_BASE_RATE_CENTS_PER_DAY=5000
# Maximum length, in days, of a single exclusivity window -- prevents a
# brand from locking a category indefinitely.
EXCLUSIVITY_MAX_DAYS=90

# Platform-funded bonus paid to a rep when their challenge submission
# converts to a campaign invitation. Funded from platform margin, not
# charged to brand.
CHALLENGE_CONVERSION_BONUS_CENTS=750

# UUID of the "FTC Disclosure Essentials" learning_modules row, once
# created by an admin. Empty until then -- the FTC gate on campaign
# accept is skipped (with a warning log) while this is unset.
FTC_MODULE_ID=
